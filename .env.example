# Optional overrides. Without an LLM_API_KEY, the server starts in setup mode.
HOST=127.0.0.1
PORT=4310
# Relative to the monorepo root, including when launched through a workspace.
DATA_DIR=./data
AGENT_SERVER_URL=http://127.0.0.1:4310

# Custom OpenAI-compatible Chat Completions provider. Keep the real key in .env.
# Starting the server does not send a model request. Run yarn check:provider explicitly.
LLM_API_KEY=
LLM_BASE_URL=https://api.callstack.ai/v1
LLM_MODEL=callstack/Apex
