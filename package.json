{
  "name": "pi-durable-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "apps/server",
    "apps/terminal"
  ],
  "scripts": {
    "dev:server": "yarn workspace @pi-durable-bot/server dev",
    "dev:terminal": "yarn workspace @pi-durable-bot/terminal dev",
    "start:server": "yarn workspace @pi-durable-bot/server start",
    "start:terminal": "yarn workspace @pi-durable-bot/terminal start",
    "build": "yarn workspaces foreach -A --exclude pi-durable-bot run build",
    "typecheck": "yarn workspaces foreach -A --exclude pi-durable-bot run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "yarn lint && yarn typecheck",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f server",
    "check:provider": "yarn workspace @pi-durable-bot/server check:provider",
    "test": "yarn workspace @pi-durable-bot/server test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
